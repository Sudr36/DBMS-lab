Q1
SELECT DISTINCT P.PNo
FROM PROJECT P
JOIN WORKS_ON W ON P.PNo = W.PNo
JOIN EMPLOYEE E ON W.SSN = E.SSN
WHERE E.Name LIKE '%Scott'

UNION

SELECT DISTINCT P.PNo
FROM PROJECT P
JOIN DEPARTMENT D ON P.DNo = D.DNo
JOIN EMPLOYEE E ON D.MgrSSN = E.SSN
WHERE E.Name LIKE '%Scott';

Q2
SELECT E.Name,
       E.Salary AS OldSalary,
       E.Salary * 1.10 AS NewSalary
FROM EMPLOYEE E
JOIN WORKS_ON W ON E.SSN = W.SSN
JOIN PROJECT P ON W.PNo = P.PNo
WHERE P.PName = 'IoT';

Q3
SELECT
    SUM(E.Salary) AS TotalSalary,
    MAX(E.Salary) AS MaximumSalary,
    MIN(E.Salary) AS MinimumSalary,
    AVG(E.Salary) AS AverageSalary
FROM EMPLOYEE E
JOIN DEPARTMENT D ON E.DNo = D.DNo
WHERE D.DName = 'Accounts';

Q4
SELECT E.Name
FROM EMPLOYEE E
WHERE NOT EXISTS (
    SELECT P.PNo
    FROM PROJECT P
    WHERE P.DNo = 5
    AND NOT EXISTS (
        SELECT *
        FROM WORKS_ON W
        WHERE W.SSN = E.SSN
        AND W.PNo = P.PNo
    )
);

Q5
SELECT DNo,
       COUNT(CASE WHEN Salary > 600000 THEN 1 END) AS HighSalaryEmployees
FROM EMPLOYEE
GROUP BY DNo
HAVING COUNT(*) > 5;
