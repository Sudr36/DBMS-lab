Q1>

SELECT COUNT(*) AS Count_Above_Avg
FROM CUSTOMER
WHERE Grade >
(
    SELECT AVG(Grade)
    FROM CUSTOMER
    WHERE City='Bangalore'
);





Q2>

SELECT S.Salesman_id, S.Name, COUNT(C.Customer_id) AS Total_Customers
FROM SALESMAN S, CUSTOMER C
WHERE S.Salesman_id = C.Salesman_id
GROUP BY S.Salesman_id, S.Name
HAVING COUNT(C.Customer_id) > 1;





Q3>

SELECT S.Name, S.City, 'Has Customer' AS Status
FROM SALESMAN S, CUSTOMER C
WHERE S.City = C.City

UNION

SELECT S.Name, S.City, 'No Customer' AS Status
FROM SALESMAN S
WHERE S.City NOT IN
(
    SELECT City
    FROM CUSTOMER
);





Q4>

CREATE VIEW Highest_Order_Salesman AS
SELECT O.Ord_Date, S.Salesman_id, S.Name, O.Purchase_Amt
FROM ORDERS O, SALESMAN S
WHERE O.Salesman_id = S.Salesman_id
AND O.Purchase_Amt =
(
    SELECT MAX(Purchase_Amt)
    FROM ORDERS
    WHERE Ord_Date = O.Ord_Date
);

SELECT * FROM Highest_Order_Salesman;





